# Copy to .env and fill in. .env is git-ignored; never commit a real value.
# Neither is needed to replay a recorded review or to run the tests.

# Anthropic API key: needed only to run or record a live review.
ANTHROPIC_API_KEY=

# GitHub fine-grained token with read-only access to public repositories:
# needed only to run or record a live review.
GITHUB_TOKEN=
